# Local development reference
# Run npm run setup with no .env file to generate database credentials and an
# encryption key. Copy only the optional settings you need into that file.
# If the default local PostgreSQL admin connection does not work, set
# LOCAL_DATABASE_ADMIN_URL in your shell before running setup.

# Generated by setup: DATABASE_URL, WORKER_DATABASE_URL, PLATFORM_DATABASE_URL,
# MAIL_DATABASE_URL, RESELLER_API_DATABASE_URL, RESELLER_DATABASE_URL,
# and ENCRYPTION_KEY. Keep these values private and keep the encryption key.

# Local services
NODE_ENV=development
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:5173
PORT=4000
REDIS_URL=redis://localhost:6379/0
WORKSPACE_SUBDOMAINS_ENABLED=false
DEMO_ENABLED=true

# Optional Google and Microsoft OAuth
# Register the exact callback URLs for your app origin. Without overrides,
# Outreach and Calendar use /api/outreach/oauth/{provider}/callback and
# /api/calendar/oauth/{provider}/callback under APP_ORIGIN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# When set, this overrides the shared Google callback for Calendar only.
GOOGLE_CALENDAR_REDIRECT_URI=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Optional WhatsApp AI replies
# Supply your own API key. For 60db use the endpoint and model below.
# OUTREACH_LLM_URL=https://api.60db.ai/v1/chat/completions
# OUTREACH_LLM_MODEL=vyas
OUTREACH_LLM_URL=
OUTREACH_LLM_MODEL=
OUTREACH_LLM_API_KEY=

# Optional Dodo Payments sandbox
# Use API keys, webhook signing credentials and products from the same mode.
DODO_ENVIRONMENT=test_mode
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=
# Optional legacy product ID, for reconciliation of existing subscriptions.
DODO_PRODUCT_ID=
ENTERPRISE_EMAIL=

# Email transport: configure platform SMTP in Superadmin → Email.
# Configure each workspace's outreach mailbox under Outreach → Connections.
# Optional local directory for platform email previews instead of sending.
# PLATFORM_MAIL_PREVIEW_SINK=/absolute/path/to/private-mail-previews
