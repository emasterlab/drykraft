DATABASE_URL=postgresql://drykraft_app:replace_with_app_password@localhost:5432/drykraft\nWORKER_DATABASE_URL=postgresql://drykraft_worker:replace_with_worker_password@localhost:5432/drykraft\nPLATFORM_DATABASE_URL=postgresql://drykraft_platform:replace_with_separate_platform_password@localhost:5432/drykraft\nREDIS_URL=redis://localhost:6379/0\n# Generated by npm run setup for local development.\nENCRYPTION_KEY=\nAPP_DOMAIN=localhost\nWORKSPACE_SUBDOMAINS_ENABLED=false\nPORT=4000\nNODE_ENV=development\nDEMO_ENABLED=true\n# Keep provider credentials server-side. Live and test products/keys are separate.\nDODO_ENVIRONMENT=test_mode\nDODO_API_KEY=\nDODO_WEBHOOK_KEY=\nDODO_PRODUCT_ID=\n# Continuing products; keep DODO_PRODUCT_ID for legacy reconciliation.\nDODO_MONTHLY_PRODUCT_ID=\nDODO_ANNUAL_PRODUCT_ID=\nENTERPRISE_EMAIL=\n# Native email callbacks must be registered in each provider's app console.\nAPP_ORIGIN=http://localhost:5173\nGOOGLE_OAUTH_CLIENT_ID=\nGOOGLE_OAUTH_CLIENT_SECRET=\n# Optional shared Google callback; register the exact URL on the matching client.\nGOOGLE_OAUTH_REDIRECT_URI=\n# Leave blank to use GOOGLE_OAUTH_REDIRECT_URI for Calendar too.\nGOOGLE_CALENDAR_REDIRECT_URI=\nMS_OAUTH_CLIENT_ID=\nMS_OAUTH_CLIENT_SECRET=\n# Platform SMTP settings. System email flows must explicitly use this transport.\n# Port 587 uses STARTTLS; keep credentials in the private .env file.\nSMTP_HOST=\nSMTP_PORT=587\nSMTP_SECURE=false\nSMTP_REQUIRE_TLS=true\nSMTP_USER=\nSMTP_PASSWORD=\nSMTP_FROM=\n\n\n# Optional WhatsApp AI replies. Use your own chat endpoint, model and private key.\n# For 60db, use https://api.60db.ai/v1/chat/completions and model vyas.\nOUTREACH_LLM_URL=\nOUTREACH_LLM_MODEL=\nOUTREACH_LLM_API_KEY=\n