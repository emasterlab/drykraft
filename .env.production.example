# Production template only. Keep real credentials in the server's private .env.\n# Preserve existing production passwords and ENCRYPTION_KEY when updating settings.\nDATABASE_URL=postgresql://drykraft_app:replace_with_production_app_password@localhost:5432/drykraft\nWORKER_DATABASE_URL=postgresql://drykraft_worker:replace_with_production_worker_password@localhost:5432/drykraft\nPLATFORM_DATABASE_URL=postgresql://drykraft_platform:replace_with_production_platform_password@localhost:5432/drykraft\nMAIL_DATABASE_URL=postgresql://drykraft_mail:replace_with_production_mail_password@localhost:5432/drykraft\nRESELLER_API_DATABASE_URL=postgresql://drykraft_reseller_api:replace_with_production_reseller_api_password@localhost:5432/drykraft\nRESELLER_DATABASE_URL=postgresql://drykraft_reseller:replace_with_production_reseller_password@localhost:5432/drykraft\nREDIS_URL=redis://localhost:6379/2\nENCRYPTION_KEY=replace_with_existing_production_64_hex_key\nAPP_DOMAIN=drykraft.com\nAPP_ORIGIN=https://app.drykraft.com\nWEBSITE_ORIGIN=https://drykraft.com\nWORKSPACE_SUBDOMAINS_ENABLED=true\nPORT=4100\nNODE_ENV=production\nDEMO_ENABLED=false\n# Use the OAuth client whose Google Console registration contains the URL below.\nGOOGLE_OAUTH_CLIENT_ID=\nGOOGLE_OAUTH_CLIENT_SECRET=\n# Every workspace shares this callback and returns to its starting workspace.\nGOOGLE_OAUTH_REDIRECT_URI=https://app.drykraft.com/api/outreach/oauth/google/callback\n# Leave blank so Google Calendar shares the registered callback above.\nGOOGLE_CALENDAR_REDIRECT_URI=\nMS_OAUTH_CLIENT_ID=\nMS_OAUTH_CLIENT_SECRET=\n# Keep any other existing private billing, SMTP and provider settings on the server.\n\n\n# Optional WhatsApp AI replies. Use your own chat endpoint, model and private key.\n# For 60db, use https://api.60db.ai/v1/chat/completions and model vyas.\nOUTREACH_LLM_URL=\nOUTREACH_LLM_MODEL=\nOUTREACH_LLM_API_KEY=\n