# Self-hosted production template
# Use example.com only as a placeholder. Configure actual domains, PostgreSQL
# credentials and an encryption key before starting a new deployment.
# For an existing deployment, merge changes into its private .env and keep its
# existing database passwords and ENCRYPTION_KEY. Do not commit real values.

# App and website addresses
NODE_ENV=production
APP_DOMAIN=example.com
APP_ORIGIN=https://app.example.com
WEBSITE_ORIGIN=https://example.com
PORT=4100
DEMO_ENABLED=false
# Enable only after wildcard DNS, HTTPS and routing are configured.
WORKSPACE_SUBDOMAINS_ENABLED=false

# PostgreSQL runtime roles
# Replace each password placeholder with the matching URL-encoded password.
# These services use separate roles. Run migrations with a separate, temporary
# DATABASE_MIGRATION_URL that has DDL permissions on the DryKraft database.
DATABASE_URL=postgresql://drykraft_app:replace_app_password@localhost:5432/drykraft
WORKER_DATABASE_URL=postgresql://drykraft_worker:replace_worker_password@localhost:5432/drykraft
PLATFORM_DATABASE_URL=postgresql://drykraft_platform:replace_platform_password@localhost:5432/drykraft
MAIL_DATABASE_URL=postgresql://drykraft_mail:replace_mail_password@localhost:5432/drykraft
RESELLER_API_DATABASE_URL=postgresql://drykraft_reseller_api:replace_reseller_api_password@localhost:5432/drykraft
RESELLER_DATABASE_URL=postgresql://drykraft_reseller:replace_reseller_password@localhost:5432/drykraft

# Redis and encryption
# Point every API instance and worker at the same DryKraft Redis database.
REDIS_URL=redis://localhost:6379/2
# Generate a new value once with openssl rand -hex 32, then back it up privately.
ENCRYPTION_KEY=

# Optional Google and Microsoft OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# If configured, both Google connectors can share the registered callback.
# GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/outreach/oauth/google/callback
# GOOGLE_CALENDAR_REDIRECT_URI=https://app.example.com/api/calendar/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
# Microsoft derives separate Outreach and Calendar callbacks from APP_ORIGIN.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Optional WhatsApp AI replies
# Supply your own API key. For 60db use the endpoint and model below.
# OUTREACH_LLM_URL=https://api.60db.ai/v1/chat/completions
# OUTREACH_LLM_MODEL=vyas
OUTREACH_LLM_URL=
OUTREACH_LLM_MODEL=
OUTREACH_LLM_API_KEY=

# Optional Dodo Payments
# Set test_mode or live_mode and use credentials and products from that mode.
# Register APP_ORIGIN + /api/billing/dodo/webhook with your Dodo account.
DODO_ENVIRONMENT=
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=
# Optional legacy product ID, for reconciliation of existing subscriptions.
DODO_PRODUCT_ID=
ENTERPRISE_EMAIL=

# Configure platform SMTP in Superadmin → Email and run the mail worker.
# Configure workspace provider accounts under Outreach → Connections.
# PLATFORM_INVITATION_ORIGIN=https://app.example.com
# Optional isolated workflow Code runner socket, if deployed on this host.
# CODE_SANDBOX_SOCKET=/run/drykraft-code/runner.sock
